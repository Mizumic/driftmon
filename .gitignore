# 本机配置（含本机 DSH_HOME 路径或本地路由），入库的是 *.example.json
config.json
config.*.json
!config.example.json
!config.*.example.json

# 本地环境变量与依赖
node_modules/
.env
.env.*
!.env.example

# 本机符号映射（真实路径/本机值，不入库）
.local/
